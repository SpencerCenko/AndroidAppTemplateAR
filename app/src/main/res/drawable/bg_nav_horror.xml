<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de navegação escura com um fio vermelho no topo.
     Funciona em qualquer versão do Android (não usa android:height). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camada de baixo: a cor do fio (aparece só nos 2dp de cima) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#7A1019" />
        </shape>
    </item>

    <!-- Camada de cima: fundo escuro, começando 2dp abaixo do topo -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0D" />
        </shape>
    </item>

</layer-list>
